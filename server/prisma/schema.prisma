generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users User[]
  products Product[]
  orders SalesOrder[]
  purchaseOrders PurchaseOrder[]
  approvals Approval[]
  receivables Receivable[]
  auditEvents AuditEvent[]
  customers Customer[]
  suppliers Supplier[]
  payments Payment[]
  @@index([isDemo, createdAt])
  @@map("organizations")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  email String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  name String @db.VarChar(120)
  role String @default("admin") @db.VarChar(30)
  failedLogins Int @default(0) @map("failed_logins")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@map("users")
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  sku String @db.VarChar(40)
  name String @db.VarChar(140)
  unitPrice Decimal @map("unit_price") @db.Decimal(12,2)
  onHand Int @default(0) @map("on_hand")
  reserved Int @default(0)
  reorderPoint Int @default(10) @map("reorder_point")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items SalesOrderItem[]
  movements InventoryMovement[]
  purchaseOrders PurchaseOrder[]
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("products")
}

model SalesOrder {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  number String @db.VarChar(30)
  customerName String @map("customer_name") @db.VarChar(160)
  customerId String? @map("customer_id") @db.Uuid
  status String @default("draft") @db.VarChar(30)
  discountPct Int @default(0) @map("discount_pct")
  total Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items SalesOrderItem[]
  approvals Approval[]
  purchaseOrders PurchaseOrder[]
  receivable Receivable?
  customer Customer? @relation(fields: [customerId], references: [id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("sales_orders")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String @db.VarChar(160)
  email String? @db.VarChar(255)
  phone String? @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders SalesOrder[]
  @@unique([organizationId, name])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("customers")
}

model Supplier {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String @db.VarChar(160)
  email String? @db.VarChar(255)
  phone String? @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  @@unique([organizationId, name])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("suppliers")
}

model SalesOrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12,2)
  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@index([orderId])
  @@map("sales_order_items")
}

model Approval {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  orderId String @map("order_id") @db.Uuid
  status String @default("pending") @db.VarChar(20)
  reason String @db.VarChar(240)
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([organizationId, status])
  @@unique([organizationId, orderId])
  @@map("approvals")
}

model PurchaseOrder {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  salesOrderId String @map("sales_order_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  number String @db.VarChar(30)
  supplier String @db.VarChar(160)
  supplierId String? @map("supplier_id") @db.Uuid
  status String @default("ordered") @db.VarChar(20)
  quantity Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  supplierRecord Supplier? @relation(fields: [supplierId], references: [id])
  @@unique([organizationId, number])
  @@map("purchase_orders")
}

model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  kind String @db.VarChar(20)
  quantity Int
  reference String @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, createdAt(sort: Desc)])
  @@unique([productId, kind, reference])
  @@map("inventory_movements")
}

model Receivable {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid
  amount Decimal @db.Decimal(12,2)
  paid Decimal @default(0) @db.Decimal(12,2)
  status String @default("open") @db.VarChar(20)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments Payment[]
  @@index([organizationId, status])
  @@map("receivables")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  receivableId String @map("receivable_id") @db.Uuid
  amount Decimal @db.Decimal(12,2)
  reference String @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  @@unique([organizationId, reference])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("payments")
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  entityType String @map("entity_type") @db.VarChar(30)
  entityId String @map("entity_id") @db.Uuid
  action String @db.VarChar(40)
  detail Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt(sort: Desc)])
  @@unique([organizationId, entityId, action])
  @@map("audit_events")
}
